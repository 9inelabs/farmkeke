# Written by `npx convex dev` into .env.local (do not commit .env.local).
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=

# Secrets and settings live on the Convex deployment, not here:
#   npx convex env set NAME=value
# JWT_PRIVATE_KEY, JWKS   Convex Auth signing keys (Phase 1)
# SITE_URL                https site URL (the deployment's .convex.site URL until farmkeke.com)
# AUTH_RESEND_KEY         Resend API key for all email (password resets)
# AUTH_EMAIL_FROM         e.g. "Farmkeke <no-reply@farmkeke.com>" (domain verified in Resend)
# AUTH_DEV_LOG_EMAILS     "true" on the dev deployment only: logs email links when no Resend key
